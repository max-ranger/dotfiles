{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/basic-memory-context.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/security-gate.sh",
            "timeout": 10,
            "statusMessage": "SecurityGate"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/secure-commits.sh",
            "timeout": 15,
            "statusMessage": "SecureCommits"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/commit-hygiene.sh",
            "timeout": 10,
            "statusMessage": "CommitHygiene"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/pre-commit-checks.sh",
            "timeout": 180,
            "statusMessage": "PreCommitChecks"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/format-on-save.sh",
            "timeout": 30,
            "statusMessage": "Auto-Format",
            "async": true
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "impeccable@impeccable": true,
    "warp@claude-code-warp": true
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    }
  },
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "theme": "auto",
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true
}
