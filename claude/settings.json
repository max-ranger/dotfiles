{
  "model": "fable[1m]",
  "outputStyle": "Concise",
  "effortLevel": "xhigh",
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "impeccable@impeccable": true,
    "ranger-claude@ranger": true,
    "dart-flutter@dart-flutter": true,
    "vue-best-practices@vue-skills": true,
    "vue-pinia-best-practices@vue-skills": true,
    "vue-router-best-practices@vue-skills": true,
    "vue-testing-best-practices@vue-skills": true,
    "vue-debug-guides@vue-skills": true,
    "create-adaptable-composable@vue-skills": true
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "ranger": {
      "source": {
        "source": "github",
        "repo": "max-ranger/dotfiles"
      }
    },
    "dart-flutter": {
      "source": {
        "source": "github",
        "repo": "flutter/agent-plugins"
      }
    },
    "vue-skills": {
      "source": {
        "source": "github",
        "repo": "vuejs-ai/skills"
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "theme": "auto",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipWorkflowUsageWarning": true,
  "permissions": {
    "allow": [
      "Bash(gh secret set *)",
      "Bash(gh secret delete *)",
      "Bash(zero env remove *)",
      "Bash(zero deploy *)",
      "Bash(zero stop *)",
      "Bash(zero start *)",
      "Bash(infra/bin/env-push.sh *)",
      "Bash(infra/bin/provision.sh *)",
      "Bash(docker push ghcr.io/max-ranger/*)",
      "Bash(docker --context ranger run *)",
      "Bash(docker --context ranger exec ranger-postgres psql *)"
    ]
  }
}
